{
    auto_https off
}


192.168.1.1, 192.168.1.2 {

    tls /etc/caddy/certs/ip.pem /etc/caddy/certs/ip-key.pem

    handle /ai* {
        uri strip_prefix /ai
        reverse_proxy samatha-ai:8080
    }

    handle /monitor* {
        uri strip_prefix /monitor
        reverse_proxy rpi-monitor:61208
    }

    handle {
        reverse_proxy repo-readme-ui:80
    }
}


rpiai.local {

    tls /etc/caddy/certs/rpiai.local.pem /etc/caddy/certs/rpiai.local-key.pem

    handle /readme* {
        uri strip_prefix /readme
        reverse_proxy repo-readme-ui:80
    }

    handle /monitor* {
        uri strip_prefix /monitor
        reverse_proxy rpi-monitor:61208
    }

    handle /ai* {
        uri strip_prefix /ai
        reverse_proxy samatha-ai:8080
    }

    handle {
        reverse_proxy samatha-ai:8080
    }
}

